# Copy to sample.ymal on the remote server, then edit paths and values.
# Input priority: input_raw_dir > input_npy > data_dir1/data_dir2.
# To calculate metrics, use input_npy + label_npy, or paired data directories.

gpu_id: 0
input_raw_dir: /path/to/inference/raw_slices
raw_height: 1024
raw_width: 1024
raw_dtype: float32
raw_pattern: "*.raw"
raw_order: C
raw_volume_name: inference_volume
independent_raws: false      # true: test each slice independently, without z-neighbors
input_npy: ""
label_npy: ""               # CT/ground-truth label for input_npy; enables metrics
data_dir1: ""               # paired CT/ground-truth NPY directory
data_dir2: ""               # paired CL/input NPY directory
model_path: /path/to/checkpoints/ema_npy_0.9999_150000.pt
output_dir: result/inference_run
sampler: ddim
ddim_steps: 25
p_sample_steps: 50
warm_start_strength: 0.8
save_global_png: false
save_xz_png: false
save_re_npy: true
normalize_output_volume: false
save_input_scale_npy: false
save_input_scale_png: false
metrics_align: none          # none: direct metrics; affine: fit scale/bias before metrics
max_samples: 0
slover_data: "no"

# These must match the trained checkpoint and training crop.
image_size: 768
condition_channels: 3
num_channels: 64
num_res_blocks: 2
num_heads: 4
num_heads_upsample: -1
num_head_channels: -1
attention_resolutions: "16,8"
channel_mult: ""
dropout: 0.0
use_checkpoint: false
use_scale_shift_norm: true
resblock_updown: false
use_fp16: false
use_new_attention_order: false
learn_sigma: true
diffusion_steps: 1000
noise_schedule: linear
timestep_respacing: ""
use_kl: false
predict_xstart: false
rescale_timesteps: false
rescale_learned_sigmas: false
crop_x_start: 127
crop_x_end: 895
crop_y_start: 127
crop_y_end: 895
use_mmap: true
normalization_mode: volume   # slice / volume / percentile
percentile_low: 1.0
percentile_high: 99.0
